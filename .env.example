# Supabase — the wearable's live link and history store.
#
# The wearable (via a phone bridge) inserts rows into `telemetry_readings`
# and `fall_events`; the browser subscribes via Supabase Realtime and reads
# the same tables. Use the project's *publishable* (anon) key — never the
# service-role secret. Apply `supabase/migrations/` first (Supabase CLI, or
# paste into the SQL Editor).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional — Resend API key for /api/notify. Without it the endpoint logs
# and returns success in demo mode.
# RESEND_API_KEY=re_replace_me
